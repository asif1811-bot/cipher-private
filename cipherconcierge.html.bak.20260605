<script>
function showWAQR() {
  document.getElementById('wa-qr-modal').style.display = 'flex';
}
document.getElementById('wa-qr-modal').addEventListener('click', function(e) {
  if (e.target === this) this.style.display = 'none';
});

function openApp() {
  var ua = navigator.userAgent || navigator.vendor || window.opera;
  if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
    // iOS — App Store link (update when app is live)
    window.open('https://apps.apple.com/au/app/consiere/id0000000000', '_blank');
  } else if (/android/i.test(ua)) {
    // Android — Play Store link (update when app is live)
    window.open('https://play.google.com/store/apps/details?id=com.consiere.app', '_blank');
  } else {
    // Desktop — redirect to portal
    window.location.href = '/cc-portal';
  }
}
</script>

