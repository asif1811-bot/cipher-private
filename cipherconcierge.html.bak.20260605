  <script>
  var CURRENCY = {
    AU:{sym:'A$',code:'AUD',r:[29,49,99]},
    US:{sym:'$',code:'USD',r:[19,32,65]},
    CA:{sym:'CA$',code:'CAD',r:[31,53,107]},
    AE:{sym:'AED ',code:'AED',r:[70,118,239]},
    SG:{sym:'S$',code:'SGD',r:[26,43,87]},
    IN:{sym:'₹',code:'INR',r:[1590,2690,5450]},
    GB:{sym:'£',code:'GBP',r:[15,25,51]},
    NZ:{sym:'NZ$',code:'NZD',r:[32,54,109]},
    JP:{sym:'¥',code:'JPY',r:[2900,4900,9900]},
    HK:{sym:'HK$',code:'HKD',r:[150,255,515]},
    SA:{sym:'SAR ',code:'SAR',r:[72,122,247]},
    QA:{sym:'QAR ',code:'QAR',r:[70,118,239]},
    CH:{sym:'CHF ',code:'CHF',r:[17,28,57]},
    EU:{sym:'€',code:'EUR',r:[18,30,61]},
    DE:{sym:'€',code:'EUR',r:[18,30,61]},
    FR:{sym:'€',code:'EUR',r:[18,30,61]},
    IT:{sym:'€',code:'EUR',r:[18,30,61]},
    ES:{sym:'€',code:'EUR',r:[18,30,61]},
  };
  async function detectCurrency(){
    try{
      var r=await fetch('https://ipapi.co/json/');
      var d=await r.json();
      var cc=d.country_code||'AU';
      var cur=CURRENCY[cc]||CURRENCY['AU'];
      var amts=document.querySelectorAll('.pc-amt');
      var syms=document.querySelectorAll('.cur-sym');
      amts[0].textContent=cur.r[0].toLocaleString();
      amts[1].textContent=cur.r[1].toLocaleString();
      amts[2].textContent=cur.r[2].toLocaleString();
      syms.forEach(function(s){s.textContent=cur.sym;});
      document.getElementById('note-ess').textContent=cur.code+' · billed monthly';
      document.getElementById('note-blk').textContent=cur.code+' · billed monthly';
      document.getElementById('note-sov').textContent=cur.code+' · billed monthly';
      var notice=document.getElementById('currency-notice');
      if(cc!=='AU'){
        notice.innerHTML='&#9432; Prices shown in '+cur.code+'. Billing processed in AUD.';
      } else {
        notice.innerHTML='&#9432; Prices in Australian Dollars (AUD)';
      }
    }catch(e){
      document.getElementById('currency-notice').innerHTML='&#9432; Prices in Australian Dollars (AUD)';
    }
  }
  detectCurrency();
  </script>
</section>

