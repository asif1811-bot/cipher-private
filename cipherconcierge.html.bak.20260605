<script>
var conv=[
  {r:'me',t:"Just arrived in Sydney from London. Need TFN, Medicare, and a bank account."},
  {r:'them',t:"Welcome to Sydney! I'll handle all three. For the TFN I need your passport and visa details — I can lodge all three applications within the hour."},
  {r:'me',t:"Amazing. Also need a 2-bed rental in Bondi or Coogee, under $2,800/month."},
  {r:'them',t:"On it. Searching Bondi, Coogee and Randwick now. I'll send you 5 shortlisted properties in 10 minutes. ✓"}
];
var ci=0, db=document.getElementById('db');
function addMsg(r,t){var d=document.createElement('div');d.className='dm '+r;var a=document.createElement('div');a.className='dm-av';a.textContent=r==='them'?'CC':'Me';var b=document.createElement('div');b.className='bubble';b.textContent=t;d.appendChild(a);d.appendChild(b);db.appendChild(d);db.scrollTop=db.scrollHeight;}
function addTyp(){var d=document.createElement('div');d.className='dm them';d.id='typ';var a=document.createElement('div');a.className='dm-av';a.textContent='CC';var b=document.createElement('div');b.className='bubble';var t=document.createElement('div');t.className='typing';t.innerHTML='<span></span><span></span><span></span>';b.appendChild(t);d.appendChild(a);d.appendChild(b);db.appendChild(d);db.scrollTop=db.scrollHeight;}
function rmTyp(){var t=document.getElementById('typ');if(t)t.remove();}
function runDemo(){
  if(ci>=conv.length){setTimeout(function(){db.innerHTML='';ci=0;setTimeout(runDemo,1500);},4000);return;}
  var m=conv[ci];
  if(m.r==='me'){setTimeout(function(){addMsg('me',m.t);ci++;addTyp();setTimeout(function(){rmTyp();runDemo();},1800);},1200);}
  else{addMsg('them',m.t);ci++;setTimeout(runDemo,2800);}
}
setTimeout(function(){addMsg('them',"Hello! I'm Alina, your personal concierge. What can I arrange for you today?");setTimeout(runDemo,2000);},1000);
function joinWL(){var e=document.getElementById('wlEmail').value.trim();if(!e||!e.includes('@')){alert('Please enter a valid email.');return;}document.querySelector('.wl-form').style.display='none';document.getElementById('wlOk').style.display='block';}
window.addEventListener('scroll',function(){var n=document.querySelector('nav');n.style.boxShadow=window.scrollY>40?'0 4px 24px rgba(0,0,0,0.07)':'none';});
</script>

