<meta charset="UTF-8">
<link rel="canonical" href="https://consiere.com.au/">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Consiere — Life, Handled.</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--copper:#b87333;--copper-light:#d4956a;--copper-pale:#f0d5c0;--cream:#faf8f5;--warm:#fff9f4;--dark:#1c1917;--mid:#44403c;--muted:#78716c;--border:rgba(184,115,51,0.15)}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--dark);overflow-x:hidden}
nav{position:fixed;top:0;left:0;right:0;z-index:100;height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 48px;background:rgba(250,248,245,0.93);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo-mark{width:32px;height:32px;background:linear-gradient(135deg,var(--copper),#8a5a2e);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:14px;color:#fff;font-weight:700}
.logo-text{font-family:'Playfair Display',serif;font-size:17px;color:var(--dark);font-weight:500}
.logo-text span{color:var(--copper)}
.nav-links{display:flex;gap:32px}
.nav-links a{font-size:13px;color:var(--mid);text-decoration:none;transition:color 0.2s}
.nav-links a:hover{color:var(--copper)}
.btn-copper{padding:9px 22px;font-size:13px;color:#fff;background:linear-gradient(135deg,var(--copper),#8a5a2e);border:none;cursor:pointer;border-radius:6px;font-weight:500;font-family:'DM Sans',sans-serif;transition:all 0.2s;box-shadow:0 2px 12px rgba(184,115,51,0.25)}
.btn-copper:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(184,115,51,0.35)}
.btn-outline{padding:9px 22px;font-size:13px;color:var(--mid);background:none;border:1px solid var(--border);cursor:pointer;border-radius:6px;font-family:'DM Sans',sans-serif;transition:all 0.2s;margin-right:8px}
.btn-outline:hover{border-color:var(--copper);color:var(--copper)}
.hero{min-height:100vh;padding:130px 48px 80px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative}
.hero::before{content:'';position:absolute;top:-200px;right:-200px;width:700px;height:700px;background:radial-gradient(circle,rgba(184,115,51,0.06) 0%,transparent 70%);pointer-events:none}
.hero-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(184,115,51,0.08);border:1px solid rgba(184,115,51,0.2);padding:6px 14px;border-radius:100px;margin-bottom:24px;font-size:11px;color:var(--copper);font-weight:500;letter-spacing:1px;text-transform:uppercase}
.dot{width:5px;height:5px;border-radius:50%;background:var(--copper);animation:pulse 2s ease infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
h1{font-family:'Playfair Display',serif;font-size:clamp(40px,5vw,66px);font-weight:500;line-height:1.1;color:var(--dark);margin-bottom:24px;letter-spacing:-1px}
h1 em{font-style:italic;color:var(--copper)}
.hero-sub{font-size:17px;color:var(--muted);line-height:1.8;margin-bottom:36px;font-weight:300}
.hero-btns{display:flex;gap:14px;margin-bottom:40px}
.btn-hero{padding:14px 32px;font-size:15px;font-weight:500;border-radius:8px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all 0.2s}
.btn-hero-p{background:linear-gradient(135deg,var(--copper),#8a5a2e);color:#fff;border:none;box-shadow:0 4px 24px rgba(184,115,51,0.3)}
.btn-hero-p:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(184,115,51,0.4)}
.btn-hero-s{background:transparent;color:var(--dark);border:1.5px solid rgba(28,25,23,0.15)}
.btn-hero-s:hover{border-color:var(--copper);color:var(--copper)}
.trust{display:flex;align-items:center;gap:16px}
.trust-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
.trust-ic{color:var(--copper)}
.trust-div{width:1px;height:14px;background:var(--border)}
.demo-wrap{background:#fff;border:1px solid var(--border);border-radius:20px;box-shadow:0 20px 80px rgba(184,115,51,0.1);overflow:hidden}
.demo-hdr{background:linear-gradient(135deg,var(--copper),#8a5a2e);padding:16px 20px;display:flex;align-items:center;gap:12px}
.demo-av{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:13px;color:#fff;font-weight:600}
.demo-name{font-size:13px;font-weight:600;color:#fff}
.demo-status{font-size:11px;color:rgba(255,255,255,0.75)}
.online{display:inline-block;width:5px;height:5px;border-radius:50%;background:#4ade80;margin-right:4px}
.demo-body{padding:18px;display:flex;flex-direction:column;gap:12px;background:#fafafa;min-height:300px}
.dm{display:flex;gap:8px;max-width:85%}
.dm.me{align-self:flex-end;flex-direction:row-reverse}
.bubble{padding:10px 14px;border-radius:14px;font-size:13px;line-height:1.6}
.dm.them .bubble{background:#fff;color:var(--dark);border:1px solid rgba(0,0,0,0.07);border-radius:4px 14px 14px 14px}
.dm.me .bubble{background:linear-gradient(135deg,var(--copper),#8a5a2e);color:#fff;border-radius:14px 4px 14px 14px}
.dm-av{width:26px;height:26px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600}
.dm.them .dm-av{background:var(--copper-pale);color:#8a5a2e}
.dm.me .dm-av{background:rgba(184,115,51,0.15);color:var(--copper)}
.demo-in{border-top:1px solid var(--border);padding:12px 16px;display:flex;gap:10px;align-items:center;background:#fff}
.demo-in-txt{flex:1;font-size:12px;color:var(--muted)}
.demo-send-btn{width:30px;height:30px;background:var(--copper);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;cursor:pointer}
.typing{display:flex;gap:4px;align-items:center}
.typing span{width:6px;height:6px;border-radius:50%;background:var(--copper-light);animation:t 1.2s ease infinite}
.typing span:nth-child(2){animation-delay:0.2s}
.typing span:nth-child(3){animation-delay:0.4s}
@keyframes t{0%,60%,100%{transform:translateY(0);opacity:0.4}30%{transform:translateY(-4px);opacity:1}}
.strip{background:linear-gradient(135deg,var(--copper),#8a5a2e);padding:36px 48px;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
.strip-n{font-family:'Playfair Display',serif;font-size:38px;font-weight:700;color:#fff;line-height:1;margin-bottom:5px}
.strip-l{font-size:11px;color:rgba(255,255,255,0.75);letter-spacing:1px;text-transform:uppercase}
section{padding:80px 48px}
.sec-tag{display:inline-block;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--copper);font-weight:500;margin-bottom:10px}
h2{font-family:'Playfair Display',serif;font-size:clamp(30px,4vw,46px);font-weight:500;color:var(--dark);margin-bottom:14px;line-height:1.15;letter-spacing:-0.5px}
h2 em{font-style:italic;color:var(--copper)}
.sub{font-size:16px;color:var(--muted);line-height:1.8;font-weight:300;max-width:540px;margin:0 auto 48px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:48px}
.step{text-align:center;padding:0 16px}
.step-n{width:72px;height:72px;border-radius:50%;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;background:rgba(184,115,51,0.08)}
.step-n-i{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;color:var(--copper)}
.step h3{font-family:'Playfair Display',serif;font-size:19px;font-weight:500;color:var(--dark);margin-bottom:8px}
.step p{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}
.svc{background:#fff;border:1px solid var(--border);border-radius:14px;padding:24px;transition:all 0.2s}
.svc:hover{border-color:var(--copper-light);transform:translateY(-2px);box-shadow:0 8px 30px rgba(184,115,51,0.08)}
.svc-ic{font-size:26px;margin-bottom:12px}
.svc h3{font-family:'Playfair Display',serif;font-size:16px;font-weight:500;color:var(--dark);margin-bottom:6px}
.svc p{font-size:12px;color:var(--muted);line-height:1.7;font-weight:300}
.svc-badge{display:inline-block;margin-top:10px;font-size:10px;color:var(--copper);background:rgba(184,115,51,0.08);padding:3px 10px;border-radius:100px}
.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:14px}
.pc{background:#fff;border:1px solid var(--border);border-radius:18px;padding:32px 28px;position:relative;transition:all 0.2s}
.pc:hover{box-shadow:0 10px 36px rgba(0,0,0,0.06);transform:translateY(-2px)}
.pc.feat{border-color:var(--copper);background:linear-gradient(160deg,#fff,rgba(184,115,51,0.03));box-shadow:0 6px 36px rgba(184,115,51,0.12)}
.pc-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--copper),#8a5a2e);color:#fff;font-size:9px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:4px 14px;border-radius:100px;white-space:nowrap}
.pc-tier{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--copper);margin-bottom:6px}
.pc-name{font-family:'Playfair Display',serif;font-size:22px;font-weight:500;color:var(--dark);margin-bottom:4px}
.pc-price{display:flex;align-items:baseline;gap:3px;margin:16px 0}
.pc-amt{font-family:'Playfair Display',serif;font-size:44px;font-weight:700;color:var(--dark);line-height:1}
.pc-per{font-size:13px;color:var(--muted)}
.pc-desc{font-size:12px;color:var(--muted);margin-bottom:20px;line-height:1.6;font-weight:300}
.pc-feats{display:flex;flex-direction:column;gap:9px;margin-bottom:24px}
.pc-feat{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--mid);line-height:1.5}
.pfc{color:var(--copper);flex-shrink:0}
.pc-btn{width:100%;padding:12px;border-radius:9px;font-size:13px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all 0.2s}
.pc-btn-p{background:linear-gradient(135deg,var(--copper),#8a5a2e);color:#fff;border:none;box-shadow:0 3px 14px rgba(184,115,51,0.25)}
.pc-btn-p:hover{transform:translateY(-1px);box-shadow:0 5px 20px rgba(184,115,51,0.35)}
.pc-btn-o{background:transparent;color:var(--dark);border:1.5px solid rgba(28,25,23,0.15)}
.pc-btn-o:hover{border-color:var(--copper);color:var(--copper)}
.ch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:40px}
.ch{background:#fff;border:1px solid var(--border);border-radius:14px;padding:24px 18px;text-align:center;transition:all 0.2s}
.ch:hover{border-color:var(--copper-light);transform:translateY(-2px);box-shadow:0 6px 24px rgba(184,115,51,0.07)}
.ch-ic{font-size:32px;margin-bottom:12px}
.ch-name{font-family:'Playfair Display',serif;font-size:15px;font-weight:500;color:var(--dark);margin-bottom:5px}
.ch-desc{font-size:12px;color:var(--muted);line-height:1.6}
.vbanner{background:linear-gradient(135deg,var(--dark),#292524);border-radius:22px;padding:52px 56px;display:grid;grid-template-columns:1fr auto;gap:36px;align-items:center;position:relative;overflow:hidden}
.vbanner::before{content:'';position:absolute;top:-80px;right:-80px;width:360px;height:360px;background:radial-gradient(circle,rgba(184,115,51,0.14) 0%,transparent 70%);pointer-events:none}
.vbanner h2{font-size:clamp(26px,3vw,36px);color:#fff;margin-bottom:10px}
.vbanner h2 em{color:var(--copper-light)}
.vbanner p{font-size:14px;color:rgba(255,255,255,0.55);line-height:1.7;font-weight:300;max-width:460px}
.vbanner-perks{display:flex;gap:16px;margin-top:22px;flex-wrap:wrap}
.vbanner-perk{font-size:12px;color:rgba(255,255,255,0.65);display:flex;align-items:center;gap:6px}
.vbanner-actions{display:flex;flex-direction:column;gap:10px;flex-shrink:0}
.btn-vp{padding:13px 28px;background:linear-gradient(135deg,var(--copper),#8a5a2e);color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;white-space:nowrap;transition:all 0.2s}
.btn-vp:hover{transform:translateY(-1px);box-shadow:0 4px 18px rgba(184,115,51,0.4)}
.btn-vg{padding:13px 28px;background:transparent;color:rgba(255,255,255,0.65);border:1px solid rgba(255,255,255,0.15);border-radius:9px;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif;white-space:nowrap;transition:all 0.2s}
.btn-vg:hover{border-color:rgba(255,255,255,0.35);color:#fff}
.wl-section{background:linear-gradient(160deg,var(--warm),var(--cream));padding:80px 48px;text-align:center;border-top:1px solid var(--border)}
.wl-form{display:flex;gap:10px;max-width:460px;margin:28px auto 0}
.wl-input{flex:1;padding:12px 16px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;color:var(--dark);background:#fff;outline:none;transition:border-color 0.2s}
.wl-input:focus{border-color:var(--copper)}
.wl-ok{display:none;padding:14px 20px;background:rgba(184,115,51,0.08);border:1px solid rgba(184,115,51,0.2);border-radius:8px;color:var(--copper);font-size:13px;margin:14px auto 0;max-width:460px}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
.testi{background:var(--cream);border:1px solid var(--border);border-radius:14px;padding:24px}
.stars{color:var(--copper);font-size:12px;margin-bottom:12px;letter-spacing:2px}
.testi-txt{font-family:'Playfair Display',serif;font-size:15px;font-style:italic;color:var(--dark);line-height:1.7;margin-bottom:18px}
.testi-auth{display:flex;align-items:center;gap:10px}
.testi-av{width:36px;height:36px;border-radius:50%;background:var(--copper-pale);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:14px;color:#8a5a2e;font-weight:600}
.testi-name{font-size:12px;font-weight:500;color:var(--dark)}
.testi-role{font-size:11px;color:var(--muted)}
footer{background:var(--dark);padding:56px 48px 28px}
.ft{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:44px;margin-bottom:44px}
.ft-logo{font-family:'Playfair Display',serif;font-size:19px;color:#fff;margin-bottom:10px}
.ft-logo span{color:var(--copper-light)}
.ft-tag{font-size:12px;color:rgba(255,255,255,0.4);line-height:1.7;margin-bottom:16px;font-weight:300}
.ft-col h4{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--copper-light);margin-bottom:14px;font-weight:500}
.ft-col a{display:block;font-size:12px;color:rgba(255,255,255,0.45);text-decoration:none;margin-bottom:9px;transition:color 0.2s}
.ft-col a:hover{color:#fff}
.ft-bot{border-top:1px solid rgba(255,255,255,0.08);padding-top:22px;display:flex;align-items:center;justify-content:space-between}
.ft-copy{font-size:11px;color:rgba(255,255,255,0.3)}
.ft-links{display:flex;gap:20px}
.ft-links a{font-size:11px;color:rgba(255,255,255,0.3);text-decoration:none}
.ft-links a:hover{color:rgba(255,255,255,0.6)}
@media(max-width:900px){
  nav{padding:0 20px}.nav-links{display:none}
  .hero{grid-template-columns:1fr;padding:100px 20px 56px}
  .demo-wrap{display:none}
  section{padding:56px 20px}
  .steps,.svc-grid,.price-grid,.ch-grid,.testi-grid{grid-template-columns:1fr}
  .strip{grid-template-columns:1fr 1fr;padding:36px 20px}
  .vbanner{grid-template-columns:1fr;padding:36px 24px}
  .ft{grid-template-columns:1fr 1fr}
  .wl-form{flex-direction:column}
}
</style>
<!-- Google Analytics: replace G-KCH521J8F3 with your real ID -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KCH521J8F3"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-KCH521J8F3');</script>
</head>
<body>

<nav>
  <a href="/" class="logo">
    <div class="logo-mark" style="padding:0;background:none;border:none;width:36px;height:36px"><svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="13" fill="none" stroke="rgba(184,115,51,0.2)" stroke-width="0.8"/><circle cx="16" cy="16" r="10" fill="none" stroke="rgba(184,115,51,0.35)" stroke-width="0.8"/><path d="M 20.5,7.8 A 9.5,9.5 0 1,0 20.5,24.2" fill="none" stroke="#b87333" stroke-width="3" stroke-linecap="round"/><circle cx="20.5" cy="7.8" r="1.8" fill="#b87333"/><circle cx="20.5" cy="24.2" r="1.8" fill="#b87333"/><polygon points="16,3 17.5,4.5 16,6 14.5,4.5" fill="#b87333"/><polygon points="16,26 17.5,27.5 16,29 14.5,27.5" fill="#b87333"/></svg></div>
    <span class="logo-text"><span>Consiere</span></span>
  </a>
  <div class="nav-links">
    <a href="#services">Services</a>
    <a href="#how">How It Works</a>
    <a href="#pricing">Pricing</a>
    <a href="mailto:vendors@consiere.com.au?subject=Vendor%20Partnership%20Enquiry">For Vendors</a>
  </div>
  <div>
    <button class="btn-outline" onclick="window.location.href='/signup'">Sign In</button>
    <button class="btn-copper" onclick="window.location.href='/signup'">Get Started</button>
  </div>
</nav>

<section class="hero">
  <div>
    <div class="hero-tag"><span class="dot"></span>Now available across Australia</div>
    <h1>Your life,<br><em>handled.</em></h1>
    <p class="hero-sub">One message. Anything sorted. From relocating to Australia to booking the impossible restaurant — Alina handles it instantly, 24/7.</p>
    <div class="hero-btns">
      <button class="btn-hero btn-hero-p" onclick="window.location.href='/signup'">Start for free</button>
      <button class="btn-hero btn-hero-s" onclick="document.getElementById('how').scrollIntoView({behavior:'smooth'})">See how it works</button>
    </div>
    <div class="trust">
      <div class="trust-item"><span class="trust-ic">&#9670;</span>AI-powered</div>
      <div class="trust-div"></div>
      <div class="trust-item"><span class="trust-ic">&#9670;</span>Australian-based</div>
      <div class="trust-div"></div>
      <div class="trust-item"><span class="trust-ic">&#9670;</span>5-minute response</div>
    </div>
  </div>
  <div class="demo-wrap">
    <div class="demo-hdr">
      <div class="demo-av">CC</div>
      <div>
        <div class="demo-name">Alina</div>
        <div class="demo-status"><span class="online"></span>Always available</div>
      </div>
    </div>
    <div class="demo-body" id="db"></div>
    <div class="demo-in">
      <div class="demo-in-txt">Type your request...</div>
      <div class="demo-send-btn">&#10148;</div>
    </div>
  </div>
</section>

<div class="strip">
  <div><div class="strip-n">5min</div><div class="strip-l">Avg Response</div></div>
  <div><div class="strip-n">200+</div><div class="strip-l">Verified Vendors</div></div>
  <div><div class="strip-n">50+</div><div class="strip-l">Task Categories</div></div>
  <div><div class="strip-n">24/7</div><div class="strip-l">AI Concierge</div></div>
</div>

<section id="how" style="text-align:center">
  <div class="sec-tag">Simple by design</div>
  <h2>Three steps to <em>anything sorted</em></h2>
  <p class="sub">No forms. No phone trees. No waiting. Send a message and Alina handles everything.</p>
  <div class="steps">
    <div class="step"><div class="step-n"><div class="step-n-i">01</div></div><h3>Send a message</h3><p>Tell us what you need in plain English — via WhatsApp, app, web, or email. No forms, no categories.</p></div>
