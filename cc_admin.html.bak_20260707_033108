<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="robots" content="noindex,nofollow">
<title>Consiere — Your life, handled.</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Space+Mono:wght@400;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;1,9..144,300&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0b0d;
  --surface: #111318;
  --surface2: #181c23;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --copper: #c8703a;
  --copper2: #e8935a;
  --copper3: rgba(200,112,58,0.12);
  --green: #3dba7c;
  --green2: rgba(61,186,124,0.12);
  --amber: #e8a03a;
  --amber2: rgba(232,160,58,0.12);
  --red: #e85a5a;
  --red2: rgba(232,90,90,0.12);
  --blue: #4a9eff;
  --blue2: rgba(74,158,255,0.12);
  --text: #e8e6e1;
  --text2: #e8e2dc;
  --text3: #c4bdb5;
  --mono: 'Space Mono', monospace;
  --sans: 'Space Grotesk', sans-serif;
  --serif: 'Fraunces', Georgia, serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--sans);background:var(--bg);color:var(--text);font-size:13px;line-height:1.5}
::selection{background:rgba(200,112,58,0.3)}
::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(200,112,58,0.3);border-radius:2px}

/* ── LAYOUT ── */
.shell{display:grid;grid-template-columns:240px 1fr;grid-template-rows:52px 1fr;height:100vh}
.topbar{grid-column:1/-1;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;gap:16px;z-index:10}
.sidebar{background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden}
.main{overflow-y:auto;overflow-x:hidden;background:var(--bg)}

/* ── TOPBAR ── */
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:28px;height:28px;background:linear-gradient(135deg,var(--copper),#8a4020);border-radius:6px;display:grid;place-items:center;font-family:var(--serif);font-size:14px;color:#fff;font-weight:500;font-style:italic;flex-shrink:0}
.brand-name{font-family:var(--serif);font-size:15px;color:var(--text);font-weight:300;letter-spacing:0.3px}
.brand-name strong{font-weight:500;color:var(--copper2)}
.brand-sep{color:var(--text2);font-size:11px;letter-spacing:3px;text-transform:uppercase}
.topbar-center{flex:1;display:flex;align-items:center;justify-content:center;gap:8px}
.status-chip{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--text2);background:var(--surface2);border:1px solid var(--border);padding:3px 10px;border-radius:100px;letter-spacing:0.5px}
.status-dot{width:5px;height:5px;border-radius:50%;background:var(--green)}
.status-dot.amber{background:var(--amber)}
.topbar-right{display:flex;align-items:center;gap:10px}
.clock{font-family:var(--mono);font-size:12px;color:var(--text3)}
.admin-pill{display:flex;align-items:center;gap:7px;background:var(--surface2);border:1px solid var(--border);padding:5px 12px;border-radius:100px}
.admin-av{width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,var(--copper),#8a4020);display:grid;place-items:center;font-size:8px;font-weight:700;color:#fff}
.admin-name{font-size:11px;color:var(--text2)}
.signout-btn{background:transparent;border:1px solid var(--border);color:var(--text3);padding:4px 10px;font-size:10px;border-radius:5px;cursor:pointer;font-family:var(--sans);letter-spacing:0.5px;transition:all 0.15s}
.signout-btn:hover{border-color:var(--copper);color:var(--copper)}

/* ── SIDEBAR ── */
.nav-group{padding:16px 12px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--text3);font-weight:500}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 12px;cursor:pointer;color:var(--text2);border-radius:6px;margin:1px 8px;transition:all 0.15s;position:relative;font-size:12px}
.nav-item:hover{background:var(--surface2);color:var(--text)}
.nav-item.on{background:rgba(200,112,58,0.1);color:var(--copper2)}
.nav-item.on::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:2px;background:var(--copper);border-radius:0 2px 2px 0;margin-left:-8px}
.nav-ic{font-size:14px;flex-shrink:0;width:16px;text-align:center}
.nav-badge{margin-left:auto;background:var(--copper);color:#fff;font-size:9px;padding:1px 6px;border-radius:100px;font-weight:700;font-family:var(--mono)}
.nav-badge.green{background:var(--green)}
.nav-foot{margin-top:auto;border-top:1px solid var(--border);padding:8px 8px 12px}

/* ── CONTENT ── */
.content{padding:24px;max-width:1400px}
.pg{display:none}.pg.on{display:block;position:fixed;top:52px;left:240px;right:0;bottom:0;overflow-y:auto;padding:24px;background:var(--bg)}
.pg-header{margin-bottom:20px}
.pg-eyebrow{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--copper);font-weight:500;margin-bottom:5px;font-family:var(--mono)}
.pg-title{font-family:var(--serif);font-size:28px;font-weight:300;color:var(--text);font-style:italic}
.pg-title strong{font-style:normal;font-weight:500}

/* ── STAT CARDS ── */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px;cursor:pointer;transition:all 0.2s;position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--copper),transparent);opacity:0;transition:opacity 0.2s}
.stat-card:hover{border-color:rgba(200,112,58,0.3);background:var(--surface2)}
.stat-card:hover::before{opacity:1}
.stat-n{font-family:var(--mono);font-size:32px;font-weight:700;color:var(--text);line-height:1;margin-bottom:5px}
.stat-n.green{color:var(--green)}
.stat-n.copper{color:var(--copper2)}
.stat-n.amber{color:var(--amber)}
.stat-l{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--text3)}
.stat-trend{font-size:10px;color:var(--text3);margin-top:4px}

/* ── CARDS ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;margin-bottom:12px;overflow:hidden}
.card-hdr{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border)}
.card-hdr-title{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--text3);font-family:var(--mono)}
.card-hdr-action{font-size:11px;color:var(--copper);cursor:pointer;transition:color 0.15s}
.card-hdr-action:hover{color:var(--copper2)}

/* ── TABLE ROWS ── */
.trow{display:flex;align-items:center;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);transition:background 0.12s}
.trow:last-child{border-bottom:none}
.trow:hover{background:rgba(255,255,255,0.02)}
.trow-main{flex:1;min-width:0}
.trow-name{font-size:13px;color:var(--text);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.trow-sub{font-size:11px;color:var(--text3);margin-top:1px}
.empty-state{text-align:center;padding:36px;font-size:11px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;font-family:var(--mono)}

/* ── TAGS ── */
.tag{font-size:9px;letter-spacing:1.5px;text-transform:uppercase;padding:3px 8px;border-radius:4px;border:1px solid;white-space:nowrap;flex-shrink:0;font-family:var(--mono)}
.tag-green{color:var(--green);border-color:rgba(61,186,124,0.3);background:var(--green2)}
.tag-amber{color:var(--amber);border-color:rgba(232,160,58,0.3);background:var(--amber2)}
.tag-copper{color:var(--copper2);border-color:rgba(200,112,58,0.3);background:var(--copper3)}
.tag-red{color:var(--red);border-color:rgba(232,90,90,0.3);background:var(--red2)}
.tag-blue{color:var(--blue);border-color:rgba(74,158,255,0.3);background:var(--blue2)}
.tag-ghost{color:var(--text3);border-color:var(--border);background:transparent}

/* ── BUTTONS ── */
.btn{padding:7px 14px;font-size:11px;font-weight:500;border-radius:6px;cursor:pointer;font-family:var(--sans);transition:all 0.15s;border:none;letter-spacing:0.3px}
.btn-copper{background:var(--copper);color:#fff}
.btn-copper:hover{background:var(--copper2)}
.btn-ghost{background:transparent;border:1px solid var(--border2);color:var(--text2)}
.btn-ghost:hover{border-color:var(--copper);color:var(--copper)}
.btn-green{background:var(--green);color:#000;font-weight:600}
.btn-sm{padding:4px 10px;font-size:10px}

/* ── SELECT ── */
.sel{background:var(--surface2);border:1px solid var(--border);color:var(--text2);padding:4px 8px;font-size:10px;font-family:var(--sans);cursor:pointer;outline:none;border-radius:5px}
.sel:hover{border-color:var(--copper)}
.sel option{background:var(--surface)}

/* ── MODAL ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.overlay.open{display:flex}
.mbox{background:var(--surface);border:1px solid var(--border2);border-radius:12px;padding:28px;width:500px;max-width:95vw;max-height:90vh;overflow-y:auto;position:relative}
.mbox::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--copper),transparent)}
.m-title{font-family:var(--serif);font-size:20px;font-weight:300;color:var(--text);font-style:italic;margin-bottom:3px}
.m-sub{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:22px;font-family:var(--mono)}
.m-field{margin-bottom:13px}
.m-field label{display:block;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--copper);margin-bottom:5px;font-family:var(--mono)}
.m-field input,.m-field select{width:100%;padding:9px 12px;background:var(--surface2);border:1px solid var(--border);color:var(--text);font-size:13px;outline:none;font-family:var(--sans);border-radius:6px;transition:border-color 0.15s}
.m-field input:focus,.m-field select:focus{border-color:var(--copper)}
.m-field select option{background:var(--surface)}
.m-grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.m-footer{display:flex;gap:8px;margin-top:18px}
.m-err{display:none;padding:8px 11px;background:var(--red2);border:1px solid rgba(232,90,90,0.2);border-radius:5px;color:var(--red);font-size:11px;margin-top:8px}
.m-ok{display:none;padding:8px 11px;background:var(--green2);border:1px solid rgba(61,186,124,0.2);border-radius:5px;color:var(--green);font-size:11px;margin-top:8px}
.xbtn{position:absolute;top:14px;right:14px;background:none;border:none;color:var(--text3);font-size:16px;cursor:pointer;padding:4px;border-radius:4px;line-height:1}
.xbtn:hover{color:var(--text);background:var(--surface2)}

/* ── CHAT VIEW ── */
.chat-scroll{max-height:420px;overflow-y:auto;padding:14px;background:var(--bg);border-radius:8px;display:flex;flex-direction:column;gap:8px}
.cmsg{display:flex;gap:8px;max-width:78%}
.cmsg.me{align-self:flex-end;flex-direction:row-reverse}
.cbubble{padding:9px 13px;border-radius:10px;font-size:12px;line-height:1.6}
.cmsg.them .cbubble{background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:3px 10px 10px 10px}
.cmsg.me .cbubble{background:linear-gradient(135deg,var(--copper),#8a4020);color:#fff;border-radius:10px 3px 10px 10px}
.cav{width:24px;height:24px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;font-size:9px;font-weight:700;font-family:var(--mono)}
.cmsg.them .cav{background:var(--copper3);color:var(--copper2)}
.cmsg.me .cav{background:rgba(255,255,255,0.1);color:var(--text2)}
.ctime{font-size:9px;color:var(--text3);margin-top:2px;font-family:var(--mono)}
.cmsg.me .ctime{text-align:right}

/* ── GRID ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}

/* ── SEARCH ── */
.search-bar{display:flex;gap:8px;margin-bottom:14px}
.search-inp{flex:1;padding:8px 13px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-size:12px;font-family:var(--sans);outline:none;border-radius:6px}
.search-inp:focus{border-color:var(--copper)}
.search-inp::placeholder{color:var(--text3)}

/* ── PAYMENTS SPECIFIC ── */
.payment-flow{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:14px;display:flex;align-items:center;gap:0;overflow-x:auto}
.pf-step{display:flex;align-items:center;gap:8px;padding:8px 16px;flex-shrink:0}
.pf-arrow{color:var(--text3);font-size:16px;flex-shrink:0}
.pf-n{font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--text3);margin-bottom:2px}
.pf-v{font-size:13px;font-weight:500;color:var(--text)}
.pf-v.green{color:var(--green)}
.pf-v.copper{color:var(--copper2)}

/* ── MEMBER AVATAR ── */
.member-av{width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,var(--copper3),transparent);border:1px solid rgba(200,112,58,0.2);display:grid;place-items:center;font-family:var(--serif);font-size:16px;color:var(--copper2);flex-shrink:0;font-style:italic}
</style>
</head>
<body>
<div id="test-mode-banner" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;text-align:center;padding:8px 16px;font-size:11px;font-weight:700;letter-spacing:2px;font-family:monospace;position:fixed;top:0;left:0;right:0;z-index:99999;display:flex;align-items:center;justify-content:center;gap:12px">
  <span>⚠️ TEST MODE ONLY — NOT LIVE — DO NOT USE FOR REAL TRANSACTIONS</span>
  <button onclick="document.getElementById('test-mode-banner').style.display='none'" style="background:rgba(0,0,0,0.2);border:none;color:#000;font-size:10px;padding:2px 8px;border-radius:4px;cursor:pointer;font-weight:700">✕</button>
</div>
<style>#test-mode-banner ~ * { margin-top: 36px; } .shell { margin-top: 36px !important; }</style>


<div class="shell">

  <!-- TOPBAR -->
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark" style="padding:0;background:none;border:none;width:32px;height:32px"><svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="13" fill="none" stroke="rgba(184,115,51,0.55)" stroke-width="1.5"/><circle cx="16" cy="16" r="10" fill="none" stroke="rgba(184,115,51,0.65)" stroke-width="1.5"/><path d="M 20.5,7.8 A 9.5,9.5 0 1,0 20.5,24.2" fill="none" stroke="#b87333" stroke-width="3" stroke-linecap="round"/><circle cx="20.5" cy="7.8" r="1.8" fill="#b87333"/><circle cx="20.5" cy="24.2" r="1.8" fill="#b87333"/><polygon points="16,3 17.5,4.5 16,6 14.5,4.5" fill="#b87333"/><polygon points="16,26 17.5,27.5 16,29 14.5,27.5" fill="#b87333"/></svg></div>
      <span class="brand-name"><strong>Cipher</strong> Concierge</span>
      <span class="brand-sep">///</span>
      <span style="font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--text3);font-family:var(--mono)">Command Centre</span>
    </div>
    <div class="topbar-center">
      <div class="status-chip"><span class="status-dot"></span>API Online</div>
      <div class="status-chip"><span class="status-dot"></span>Alina Active</div>
      <div class="status-chip"><span class="status-dot"></span>Dispatch Active</div>
    </div>
    <div class="topbar-right">
      <span class="clock" id="clock">--:--</span>
      <div class="admin-pill">
        <div class="admin-av" id="adminAv">A</div>
        <span class="admin-name" id="adminName">Admin</span>
      </div>
      <button class="signout-btn" onclick="signOut()">Sign Out</button>
    </div>
  </header>

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="nav-group">Overview</div>
    <div class="nav-item on" id="nav-dash" onclick="go('dash',this)">
      <span class="nav-ic">◈</span>Dashboard
    </div>

    <div class="nav-group">Members</div>
    <div class="nav-item" id="nav-members" onclick="go('members',this)">
      <span class="nav-ic">○</span>Members
      <span class="nav-badge" id="nb-members">0</span>
    </div>
    <div class="nav-item" id="nav-requests" onclick="go('requests',this)">
      <span class="nav-ic">◇</span>Service Requests
      <span class="nav-badge amber" id="nb-requests" style="display:none">0</span>
    </div>
    <div class="nav-item" id="nav-chats" onclick="go('chats',this)">
      <span class="nav-ic">◉</span>Conversations
    </div>

    <div class="nav-group">Vendors</div>
    <div class="nav-item" id="nav-vendors" onclick="go('vendors',this)">
      <span class="nav-ic">◐</span>Vendor Network
    </div>
    <div class="nav-item" id="nav-commissions" onclick="go('commissions',this)">
      <span class="nav-ic">◆</span>Commissions
    </div>
    <div class="nav-item" id="nav-payments" onclick="go('payments',this)">
      <span class="nav-ic">$</span>Payments &amp; Payouts
    </div>

    <div class="nav-group">Growth</div>
    <div class="nav-item" id="nav-enquiries" onclick="go('enquiries',this)">
      <span class="nav-ic">≈</span>Enquiries
    </div>
    <div class="nav-item" id="nav-waitlist" onclick="go('waitlist',this)">
      <span class="nav-ic">◁</span>Waitlist
    </div>

    <div class="nav-foot">
      <div class="nav-item" onclick="window.open('https://consiere.com.au','_blank')">
        <span class="nav-ic">↗</span>Public Site
      </div>
      <div class="nav-item" id="nav-intl" onclick="go('intl',this)">
        <span class="nav-ic">🌏</span>International
      </div>
      <div class="nav-item" id="nav-broadcast" onclick="go('broadcast',this)">
        <span class="nav-ic">📣</span>WhatsApp Broadcast
      </div>
      <div class="nav-item" id="nav-contacts" onclick="go('contacts',this)">
        <span class="nav-ic">👥</span>Member Database
      </div>
      <div class="nav-item" id="nav-settings" onclick="go('settings',this)">
        <span class="nav-ic">⚙️</span>Settings & Integrations
      </div>
      <div class="nav-item" onclick="signOut()">
        <span class="nav-ic">⎋</span>Sign Out
      </div>
    </div>
  </nav>

  <!-- MAIN -->
  <main class="main">
    <div class="content">

      <!-- DASHBOARD -->
      <div class="pg on" id="pg-dash">
        <div class="pg-header">
          <div class="pg-eyebrow">Overview</div>
          <div class="pg-title">Command <strong>Dashboard</strong></div>
        </div>
        <div class="stat-grid">
          <div class="stat-card" onclick="go('members',document.getElementById('nav-members'))">
            <div class="stat-n" id="s-members">0</div>
            <div class="stat-l">Total Members</div>
            <div class="stat-trend">↗ Growing</div>
          </div>
          <div class="stat-card" onclick="go('requests',document.getElementById('nav-requests'))">
            <div class="stat-n amber" id="s-requests">0</div>
            <div class="stat-l">Active Requests</div>
            <div class="stat-trend" id="s-req-trend">Pending action</div>
          </div>
          <div class="stat-card" onclick="go('vendors',document.getElementById('nav-vendors'))">
            <div class="stat-n" id="s-vendors">0</div>
            <div class="stat-l">Vendor Partners</div>
            <div class="stat-trend">Across all categories</div>
          </div>
          <div class="stat-card" onclick="go('commissions',document.getElementById('nav-commissions'))">
            <div class="stat-n green" id="s-commission">$0</div>
            <div class="stat-l">Commission Earned</div>
            <div class="stat-trend">All time</div>
          </div>
        </div>
        <div class="g2">
          <div>
            <div class="card">
              <div class="card-hdr">
                <span class="card-hdr-title">Quick Actions</span>
              </div>
              <div style="padding:14px;display:flex;flex-direction:column;gap:7px">
                <button class="btn btn-copper" style="width:100%;text-align:left" onclick="openAddMember()">+ Add New Member</button>
