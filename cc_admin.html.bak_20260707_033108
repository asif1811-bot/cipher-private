  var status = document.getElementById('bc-status');
  status.textContent = '⏳ Sending broadcast...';
  try {
    var r = await fetch('/api/admin/broadcast', {
      method: 'POST',
      headers: { ...H, 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg, audience })
    });
    var d = await r.json();
    if (r.ok) {
      status.textContent = '✅ Sent to ' + d.sent + ' contacts' + (d.failed > 0 ? ' (' + d.failed + ' failed)' : '');
