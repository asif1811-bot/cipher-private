<style>
:root {
  --bg: #0a0b0d;
  --surface: #111318;
  --surface2: #181c23;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --copper: #c8703a;
  --copper2: #e8935a;
  --copper3: rgba(200,112,58,0.12);
  --green: #3dba7c;
  --green2: rgba(61,186,124,0.12);
