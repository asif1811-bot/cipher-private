function renderContacts(contacts) {
  var el = document.getElementById('list-contacts');
  var count = document.getElementById('contacts-count');
  if (!contacts.length) { el.innerHTML = '<div style="padding:32px;text-align:center;color:var(--text3)">No members found</div>'; return; }
  count.textContent = contacts.length + ' members shown';
  el.innerHTML = contacts.map(function(m) {
    var isWA = m.email && m.email.includes('@whatsapp.cipher');
    var phone = m.phone || (isWA ? '+' + m.email.replace('wa_','').replace('@whatsapp.cipher','') : '—');
    var country = '—';
    if (phone !== '—') {
      var p = phone.replace(/\D/g,'');
      if (p.startsWith('61') || p.startsWith('0061')) country = '🇦🇺 Australia';
      else if (p.startsWith('971')) country = '🇦🇪 UAE';
      else if (p.startsWith('65')) country = '🇸🇬 Singapore';
      else if (p.startsWith('91')) country = '🇮🇳 India';
      else if (p.startsWith('1')) country = '🇺🇸 US/Canada';
      else if (p.startsWith('44')) country = '🇬🇧 UK';
      else if (p.startsWith('64')) country = '🇳🇿 NZ';
      else if (p.startsWith('60')) country = '🇲🇾 Malaysia';
      else if (p.startsWith('66')) country = '🇹🇭 Thailand';
      else if (p.startsWith('92')) country = '🇵🇰 Pakistan';
      else country = '🌍 International';
    }
    var tierColor = m.memberTier === 'CIPHER_BLACK' ? 'var(--copper)' : 'var(--text3)';
    var tierLabel = m.memberTier === 'CIPHER_BLACK' ? 'Unlimited' : m.memberTier === 'CIPHER_SOVEREIGN' ? 'Sovereign' : 'Free';
    return '<div style="display:grid;grid-template-columns:1fr 1fr 120px 100px 120px 100px 80px;padding:12px 16px;border-bottom:1px solid var(--border);font-size:12px;align-items:center">' +
      '<div style="font-weight:500;color:var(--text)">' + (m.fullName||'Unknown') + '</div>' +
      '<div style="color:var(--text2)">' + (m.email||'') + '</div>' +
      '<div style="color:' + (phone!=='—'?'#25D366':'var(--text3)') + '">' + (phone!=='—'?'📱 ':'')+phone + '</div>' +
      '<div style="color:var(--text3);font-size:11px">' + country + '</div>' +
      '<div style="color:'+tierColor+';font-weight:500">' + tierLabel + '</div>' +
      '<div style="color:var(--text3)">$' + (m.totalPaid||0).toFixed(2) + '</div>' +
      '<div style="color:var(--text3)">' + (isWA?'WhatsApp':'Web') + '</div>' +
    '</div>';
  }).join('');
}

function filterContacts() {
  var search = (document.getElementById('contacts-search').value||'').toLowerCase();
  var filter = document.getElementById('contacts-filter').value;
  var filtered = allContacts.filter(function(m) {
    var isWA = m.email && m.email.includes('@whatsapp.cipher');
    var phone = m.phone || (isWA ? '+' + m.email.replace('wa_','').replace('@whatsapp.cipher','') : '');
    var matchSearch = !search ||
      (m.fullName||'').toLowerCase().includes(search) ||
      (m.email||'').toLowerCase().includes(search) ||
      phone.includes(search);
    var matchFilter = !filter ||
      (filter==='paid' && m.memberTier==='CIPHER_BLACK') ||
      (filter==='free' && m.memberTier==='CIPHER') ||
      (filter==='whatsapp' && (isWA || m.phone));
    return matchSearch && matchFilter;
  });
  renderContacts(filtered);
}

function exportContacts() {
  var rows = [['Name','Email','Phone','Country','Tier','Total Paid','Source']];
  allContacts.forEach(function(m) {
    var isWA = m.email && m.email.includes('@whatsapp.cipher');
    var phone = m.phone || (isWA ? '+' + m.email.replace('wa_','').replace('@whatsapp.cipher','') : '');
    rows.push([m.fullName||'',m.email||'',phone,country,m.memberTier||'CIPHER',(m.totalPaid||0).toFixed(2),isWA?'WhatsApp':'Web']);
  });
  var csv = rows.map(function(r){ return r.map(function(v){ return '"'+String(v).replace(/"/g,'""')+'"'; }).join(','); }).join('\n');
  var a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'consiere-members-' + new Date().toISOString().split('T')[0] + '.csv';
  a.click();
}

