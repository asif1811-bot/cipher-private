    document.getElementById('r-active').textContent = items.filter(function(x){return x.status!=='COMPLETED'&&x.status!=='CANCELLED';}).length;
    document.getElementById('r-done').textContent = items.filter(function(x){return x.status==='COMPLETED';}).length;
    if (!items.length) { el.innerHTML='<div class="empty-state">No requests yet</div>'; return; }
    el.innerHTML = items.map(function(x){
      var tc=x.status==='COMPLETED'?'tag-green':x.status==='IN_PROGRESS'?'tag-blue':x.status==='RECEIVED'?'tag-copper':'tag-amber';
      var deli='';
      if(x.deliveryAddress||x.recipientName||x.recipientPhone){
        deli='<div style="background:#fff8f0;border:1px solid #f0d9b5;border-radius:6px;padding:7px 12px;margin:5px 0;font-size:11px;line-height:1.8">'+(x.deliveryAddress?'<b>&#128205;</b> '+x.deliveryAddress+'&nbsp; ':'')+(x.recipientName?'<b>&#128100;</b> '+x.recipientName+'&nbsp;':'')+(x.recipientPhone?'<b>&#128241;</b> '+x.recipientPhone:'')+'</div>';
      }
      var vend='';
      if(x.vendorsContacted>0){
        vend='<div style="font-size:11px;color:#78716c;margin-top:3px">Vendors contacted: <b>'+x.vendorsContacted+'</b>'+renderVendorContacts(x)+(x.topQuote?' | Best quote: <b>$'+x.topQuote+'</b>':'')+'</div>';
      }
      return '<div class="trow" style="flex-direction:column;align-items:stretch;padding:12px 16px;gap:4px">'+
        '<div style="display:flex;align-items:center;gap:8px">'+
          '<div style="flex:1;min-width:0">'+
            '<div class="trow-name"><b>'+(x.user?x.user.fullName||x.user.email:'Unknown')+'</b> &rarr; '+(x.title||x.description||'').substring(0,70)+'</div>'+
            '<div class="trow-sub">'+(x.category||'')+' &middot; '+(x.user?x.user.memberTier||'':'')+' &middot; '+new Date(x.createdAt).toLocaleDateString('en-AU',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})+'</div>'+
          '</div>'+
          '<span class="tag '+tc+'">'+(x.status||'').replace(/_/g,' ')+'</span>'+
          '<button onclick="pushFulfilment(\''+x.id+'\')" style="background:#16a34a;color:#fff;border:0;padding:5px 12px;border-radius:5px;cursor:pointer;font-size:12px;font-weight:600;margin-right:6px">\u2705 Push fulfilment</button>'+'<select class="sel" onchange="updateReq(\''+x.id+'\',this.value)"><option value="">Update</option><option>RECEIVED</option><option>IN_PROGRESS</option><option>AWAITING_MEMBER</option><option>COMPLETED</option><option>CANCELLED</option></select>'+
        '</div>'+
        '<div style="font-size:12px;color:#44403c;background:#faf8f5;border-left:3px solid #b87333;padding:5px 10px">'+(x.description||'').substring(0,250)+'</div>'+
        deli+vend+googleVend+
      '</div>';
    }).join('');
  } catch(e) { el.innerHTML='<div class="empty-state">Failed to load</div>'; }
}

