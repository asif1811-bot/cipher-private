        '<td style="padding:5px 8px;font-size:12px;text-align:center">'+(l.googleRating||0)+'*</td>'+
        '<td style="padding:5px 8px;font-size:12px">'+site+'</td>'+
        '<td style="padding:5px 8px;font-size:12px">'+(l.vendorPhone||'-')+'</td>'+
        '<td style="padding:5px 8px;text-align:right">'+btn+'</td></tr>';
    }).join('');
    el.innerHTML = '<div style="font-size:11px;color:#b87333;margin-top:8px">GOOGLE PLACES LEADS (review &amp; invite)</div>'+
      '<table style="width:100%;border-collapse:collapse"><tbody>'+rows+'</tbody></table>';
  }catch(e){ console.error('loadDiscovered',e); }
}
async function inviteLead(id, containerId, requestId){
  if(!confirm('Send a partnership invitation email to this business?')) return;
  try{
    var r = await fetch('/api/admin/discovered/'+id+'/invite',{method:'POST',headers:H});
    var d = await r.json();
    if(d.error){ alert('Could not send: '+d.error); return; }
    loadDiscovered(requestId, containerId);
  }catch(e){ alert('Error: '+e.message); }
}

