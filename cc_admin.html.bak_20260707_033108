<script>
var TK = sessionStorage.getItem('cc_token') || sessionStorage.getItem('cipher_token');
var H  = { 'Content-Type':'application/json', 'Authorization':'Bearer '+TK };
// Keep H fresh after login
function getH() { var t=sessionStorage.getItem('cc_token')||sessionStorage.getItem('cipher_token'); H={'Content-Type':'application/json','Authorization':'Bearer '+t}; return H; }
if (!TK) {
  document.body.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;background:#0f0e0c;font-family:Georgia,serif;text-align:center"><div style="font-size:10px;letter-spacing:6px;color:#c9a96e;text-transform:uppercase;margin-bottom:24px">Consiere</div><div style="font-size:32px;color:#fff;font-weight:300;margin-bottom:12px">Access Denied</div><div style="font-size:14px;color:rgba(255,255,255,0.4);margin-bottom:32px">This area is restricted to Consiere administrators only.</div><a href="/" style="padding:12px 28px;background:#c9a96e;color:#1a1612;text-decoration:none;font-size:13px;font-weight:600;border-radius:4px">Back to Consiere</a></div>';
  throw new Error('No token');
}

// Clock
setInterval(function(){ document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-AU',{hour:'2-digit',minute:'2-digit',second:'2-digit'}); }, 1000);

var TITLES = { dash:'Dashboard', members:'Members', requests:'Service Requests', chats:'Conversations', vendors:'Vendor Network', commissions:'Commissions', payments:'Payments & Payouts', enquiries:'Enquiries', waitlist:'Waitlist' };
var allMembers = [];

function go(pg, navEl) {
  document.querySelectorAll('.pg').forEach(function(el){el.classList.remove('on');});
  document.querySelectorAll('.nav-item').forEach(function(el){el.classList.remove('on');});
  var page = document.getElementById('pg-'+pg);
  if (page) page.classList.add('on');
  if (navEl) navEl.classList.add('on');
  if (pg==='members') loadMembers();
  if (pg==='requests') loadRequests();
  if (pg==='chats') loadChats();
  if (pg==='vendors') loadVendors();
  if (pg==='commissions') loadCommissions();
  if (pg==='payments') loadPayments();
  if (pg==='enquiries') loadEnquiries();
  if (pg==='contacts') loadContacts();
  if (pg==='broadcast') loadBroadcastAudience();
  if (pg==='waitlist') loadWaitlist();
  if (pg==='intl') setTimeout(loadIntlRequests, 100);
  if (pg==='settings') { setTimeout(loadKlaviyoStatus, 100); setTimeout(checkStripeStatus, 200); setTimeout(checkTwilioStatus, 300); }
}

function openAddMember(){ ['mn-name','mn-email','mn-pass'].forEach(function(id){document.getElementById(id).value='';}); document.getElementById('mn-err').style.display='none'; document.getElementById('mn-ok').style.display='none'; document.getElementById('modal-member').classList.add('open'); setTimeout(function(){document.getElementById('mn-name').focus();},100); }
function openAddVendor(){ ['vn-name','vn-contact','vn-email','vn-phone','vn-desc','vn-pass','vn-suburbs'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='';}); document.getElementById('vn-comm').value='10'; document.getElementById('vn-cities').value='Sydney'; genPass(); document.getElementById('vn-err').style.display='none'; document.getElementById('vn-ok').style.display='none'; document.getElementById('modal-vendor').classList.add('open'); setTimeout(function(){document.getElementById('vn-name').focus();},100); }
function closeModal(n){ document.getElementById('modal-'+n).classList.remove('open'); }
document.querySelectorAll('.overlay').forEach(function(el){ el.addEventListener('click',function(e){ if(e.target===this) this.classList.remove('open'); }); });

async function loadAll() {
  if(typeof getH==='function') getH();
  try {
    var u = sessionStorage.getItem('cc_user')||sessionStorage.getItem('cipher_user');
    if (u) {
      try {
        var usr = JSON.parse(u);
        document.getElementById('adminName').textContent = usr.fullName||'Admin';
        document.getElementById('adminAv').textContent = (usr.fullName||'A')[0].toUpperCase();
      } catch(e){}
    }
    var r = await fetch('/api/admin/cc-members',{headers:H});
    if (r.status===401) {
    document.body.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;background:#0f0e0c;font-family:Georgia,serif;text-align:center"><div style="font-size:10px;letter-spacing:6px;color:#c9a96e;text-transform:uppercase;margin-bottom:24px">Consiere</div><div style="font-size:32px;color:#fff;font-weight:300;margin-bottom:12px">Access Denied</div><div style="font-size:14px;color:rgba(255,255,255,0.4);margin-bottom:32px">Administrator access required. Please sign in with an admin account.</div><a href="/cc-portal" style="padding:12px 28px;background:#c9a96e;color:#1a1612;text-decoration:none;font-size:13px;font-weight:600;border-radius:4px;margin-right:12px">Sign In</a><a href="/" style="padding:12px 28px;border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.6);text-decoration:none;font-size:13px;border-radius:4px">Back to Consiere</a></div>';
    return;
  }
    var d = await r.json();
    allMembers = Array.isArray(d)?d:(d.members||[]);
    document.getElementById('s-members').textContent = allMembers.length;
    document.getElementById('nb-members').textContent = allMembers.length;
  } catch(e){}
  try {
    var r2 = await fetch('/api/admin/cc-requests',{headers:H});
    var d2 = await r2.json();
    var reqs = Array.isArray(d2)?d2:(d2.requests||[]);
    var active = reqs.filter(function(x){return x.status!=='COMPLETED'&&x.status!=='CANCELLED';});
    document.getElementById('s-requests').textContent = active.length;
    document.getElementById('s-req-trend').textContent = active.length + ' need attention';
    if (active.length) {
      var nb = document.getElementById('nb-requests');
      nb.style.display=''; nb.textContent = active.length;
    }
    var dr = document.getElementById('dash-requests');
    if (!reqs.length) { dr.innerHTML='<div class="empty-state">No requests yet</div>'; }
    else {
      dr.innerHTML = reqs.slice(0,6).map(function(x){
        var tc = x.status==='COMPLETED'?'tag-green':x.status==='IN_PROGRESS'?'tag-blue':x.status==='RECEIVED'?'tag-copper':'tag-amber';
        return '<div class="trow"><div class="trow-main"><div class="trow-name">'+(x.title||x.description||'').substring(0,52)+'</div><div class="trow-sub">'+(x.category||'')+' &middot; '+new Date(x.createdAt).toLocaleDateString('en-AU')+'</div></div><span class="tag '+tc+'">'+(x.status||'').replace(/_/g,' ')+'</span></div>';
      }).join('');
    }
  } catch(e){}
  try {
    var r3 = await fetch('/api/vendors',{headers:H});
    var d3 = await r3.json();
    document.getElementById('s-vendors').textContent = (d3.vendors||[]).length;
  } catch(e){}
  try {
    var r4 = await fetch('/api/vendors/inquiries/all',{headers:H});
    var d4 = await r4.json();
    document.getElementById('s-commission').textContent = '$'+((d4.totalCommission||0)).toLocaleString();
  } catch(e){}
}

async function loadMembers() {
  var el = document.getElementById('list-members'); el.innerHTML='<div class="empty-state">Loading...</div>';
  try {
    var r = await fetch('/api/admin/cc-members',{headers:H}); var d = await r.json();
    allMembers = Array.isArray(d)?d:(d.members||[]);
    renderMembers(allMembers);
  } catch(e) { el.innerHTML='<div class="empty-state">Failed to load</div>'; }
}

function renderMembers(items) {
  var el = document.getElementById('list-members');
  if (!items.length) { el.innerHTML='<div class="empty-state">No members yet</div>'; return; }
  el.innerHTML = '';
  items.forEach(function(m) {
    var tier = m.memberTier||'CIPHER';
    var tc = tier==='CIPHER_SOVEREIGN'?'tag-copper':tier==='CIPHER_BLACK'?'tag-blue':'tag-ghost';
    var tierLabel = tier==='CIPHER_SOVEREIGN'?'Premium':tier==='CIPHER_BLACK'?'Standard':'Free';
    var row = document.createElement('div');
    row.className = 'trow';
    row.innerHTML =
      '<div class="member-av">'+(m.fullName||'?')[0].toUpperCase()+'</div>'+
      '<div class="trow-main">'+
        '<div class="trow-name">'+(m.fullName||'Unknown')+'</div>'+
        '<div class="trow-sub">'+(m.email||'')+' &middot; '+new Date(m.createdAt).toLocaleDateString('en-AU')+'</div>'+
      '</div>'+
      '<span class="tag '+tc+'">'+tierLabel+'</span>'+
      '<span class="tag '+(m.isActive?'tag-green':'tag-red')+'">'+(m.isActive?'Active':'Inactive')+'</span>';
    var btnView = document.createElement('button');
    btnView.className = 'btn btn-ghost btn-sm';
    btnView.textContent = 'View';
    btnView.addEventListener('click', function(){ viewMember(m); });
    row.appendChild(btnView);
    var btnToggle = document.createElement('button');
    btnToggle.className = 'btn btn-ghost btn-sm';
    btnToggle.style.cssText = 'padding:4px 10px;font-size:10px;color:'+(m.isActive?'var(--red)':'var(--green)');
    btnToggle.textContent = m.isActive ? 'Deactivate' : 'Activate';
    btnToggle.addEventListener('click', async function(){
      btnToggle.disabled=true; btnToggle.textContent='...';
      try {
        var r = await fetch('/api/admin/members/'+m.id, {method:'PATCH', headers:H, body:JSON.stringify({isActive: !m.isActive})});
        if(r.ok){loadMembers();loadAll();}
        else{alert('Failed');btnToggle.disabled=false;btnToggle.textContent=m.isActive?'Deactivate':'Activate';}
      } catch(e){alert('Error');btnToggle.disabled=false;}
    });
    row.appendChild(btnToggle);
    el.appendChild(row);
  });
}

function filterMembers() {
  var q = document.getElementById('memberSearch').value.toLowerCase();
  var tier = document.getElementById('memberTierFilter').value;
  renderMembers(allMembers.filter(function(m){
    return (!q || (m.fullName||'').toLowerCase().includes(q) || (m.email||'').toLowerCase().includes(q)) &&
           (!tier || (m.memberTier||'')=== tier);
  }));
}

async function loadRequests() {
  var el = document.getElementById('list-requests'); el.innerHTML='<div class="empty-state">Loading...</div>';
  try {
    var r = await fetch('/api/admin/cc-requests',{headers:H}); var d = await r.json();
    var items = Array.isArray(d)?d:(d.requests||[]);
    document.getElementById('r-total').textContent = items.length;
    document.getElementById('r-active').textContent = items.filter(function(x){return x.status!=='COMPLETED'&&x.status!=='CANCELLED';}).length;
    document.getElementById('r-done').textContent = items.filter(function(x){return x.status==='COMPLETED';}).length;
    if (!items.length) { el.innerHTML='<div class="empty-state">No requests yet</div>'; return; }
    el.innerHTML = items.map(function(x){
      var tc=x.status==='COMPLETED'?'tag-green':x.status==='IN_PROGRESS'?'tag-blue':x.status==='RECEIVED'?'tag-copper':'tag-amber';
      var deli='';
      if(x.deliveryAddress||x.recipientName||x.recipientPhone){
        deli='<div style="background:#fff8f0;border:1px solid #f0d9b5;border-radius:6px;padding:7px 12px;margin:5px 0;font-size:11px;line-height:1.8">'+(x.deliveryAddress?'<b>&#128205;</b> '+x.deliveryAddress+'&nbsp;':'')+(x.recipientName?'<b>&#128100;</b> '+x.recipientName+'&nbsp;':'')+(x.recipientPhone?'<b>&#128241;</b> '+x.recipientPhone:'')+'</div>';
      }
      var vend='';
      if(x.vendorsContacted>0){
        vend='<div style="font-size:11px;color:#999;margin-top:3px">📋 Registered vendors: <b>'+x.vendorsContacted+'</b>'+renderVendorContacts(x)+(x.topQuote?' | Best quote: <b>$'+x.topQuote+'</b>':'')+'</div>';
      }
      var googleVend='';
      if(x.googleVendors&&x.googleVendors.length>0){
        var vList=x.googleVendors.map(function(v){
          var statusIcon=v.status==='INVITED'?'✅':v.registeredAt?'✅':'•';
          var inviteBtn;
          if(v.registeredAt){ inviteBtn='<span style="background:#16a34a;color:#fff;font-size:10px;font-weight:700;letter-spacing:.5px;padding:3px 8px;border-radius:4px;white-space:nowrap">\u2705 REGISTERED \u2014 READY TO PUSH</span>'; }
          else if(v.status==='INVITED'){ inviteBtn='<span style="color:#34d399;font-size:12px">invited</span>'; }
          else if(v.email){ inviteBtn='<button onclick="inviteLead(\''+v.id+'\',null,null)" style="background:#b87333;color:#fff;border:0;padding:3px 9px;border-radius:4px;cursor:pointer;font-size:11px">Send invite</button>'; }
          else { inviteBtn='<span style="color:#94a3b8;font-size:11px">no email</span>'; }
