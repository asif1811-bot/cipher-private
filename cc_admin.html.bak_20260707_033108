// City → Country mapping for vendor filter
var CITY_COUNTRY_MAP = {
  'Sydney':'Australia','Melbourne':'Australia','Brisbane':'Australia','Perth':'Australia','Gold Coast':'Australia','Adelaide':'Australia',
  'Toronto':'Canada','Vancouver':'Canada','Montreal':'Canada','Calgary':'Canada','Quebec City':'Canada',
  'Dubai':'UAE','Abu Dhabi':'UAE','Sharjah':'UAE',
  'Singapore':'Singapore',
  'Delhi':'India','Mumbai':'India','Bangalore':'India','Chennai':'India','Hyderabad':'India','Kolkata':'India','Noida':'India',
  'New York':'USA','Los Angeles':'USA','Miami':'USA','Chicago':'USA','Houston':'USA','Dallas':'USA','San Francisco':'USA','Las Vegas':'USA','Fort Lauderdale':'USA',
  'London':'UK','Manchester':'UK','Edinburgh':'UK',
};
var allVendorsData = [];
var activeVendorCountry = '';

function getVendorCountryFromCities(v) {
  var cities = (v.cities||'').split(',').map(function(x){return x.trim();});
  for (var i=0;i<cities.length;i++) {
    if (CITY_COUNTRY_MAP[cities[i]]) return CITY_COUNTRY_MAP[cities[i]];
  }
  return '';
}

function filterVendors(countryOrPattern) {
  // Update active tab style
  document.querySelectorAll('[id^="vf-"]').forEach(function(btn){
    btn.style.background=''; btn.style.color=''; btn.style.borderColor='';
    btn.classList.remove('btn-gold');
    btn.classList.add('btn-ghost');
  });
  var activeBtn = null;
  if (countryOrPattern === '') activeBtn = document.getElementById('vf-all');
  else if (countryOrPattern === 'Australia') activeBtn = document.getElementById('vf-au');
  else if (countryOrPattern === 'Canada') activeBtn = document.getElementById('vf-ca');
  else if (countryOrPattern === 'UAE') activeBtn = document.getElementById('vf-ae');
  else if (countryOrPattern === 'Singapore') activeBtn = document.getElementById('vf-sg');
  else if (countryOrPattern === 'India') activeBtn = document.getElementById('vf-in');
  else if (countryOrPattern === 'USA') activeBtn = document.getElementById('vf-us');
  if (activeBtn) { activeBtn.classList.remove('btn-ghost'); activeBtn.classList.add('btn-gold'); }
  
  activeVendorCountry = countryOrPattern;
  renderVendorsByCountry(allVendorsData, countryOrPattern);
}

function renderVendorsByCountry(vendors, countryFilter) {
  var el = document.getElementById('list-vendors');
  // Filter vendors by country
  var filtered = vendors.filter(function(v) {
    if (!countryFilter) return true;
    var vCountry = getVendorCountryFromCities(v);
    return vCountry === countryFilter;
  });
  
  if (!filtered.length) {
    el.innerHTML = '<div class="empty-state">No vendors in this region yet</div>';
    return;
  }
  
  // Group by city under country
  var byCityGroups = {};
  filtered.forEach(function(v) {
    var cities = (v.cities||'').split(',').map(function(x){return x.trim();}).filter(Boolean);
    // Use first matching city as primary
    var primaryCity = cities.find(function(city) {
      if (!countryFilter) return true;
      return CITY_COUNTRY_MAP[city] === countryFilter;
    }) || cities[0] || 'Other';
    if (!byCityGroups[primaryCity]) byCityGroups[primaryCity] = [];
    if (!byCityGroups[primaryCity].find(function(x){return x.id===v.id;}))
      byCityGroups[primaryCity].push(v);
  });
  
  el.innerHTML = '';
  
  // Sort cities alphabetically
  Object.keys(byCityGroups).sort().forEach(function(city) {
    var vlist = byCityGroups[city];
    // City header
    var cityHdr = document.createElement('div');
    cityHdr.style.cssText = 'padding:8px 16px 4px;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--copper);border-bottom:1px solid var(--border);font-family:var(--mono);display:flex;align-items:center;gap:6px';
    cityHdr.innerHTML = '📍 ' + city + ' <span style="opacity:0.5">('+vlist.length+')</span>';
    el.appendChild(cityHdr);
    vlist.forEach(function(v) { el.appendChild(renderVendorRow(v)); });
  });
}

